GROQ_API_KEY=your_groq_api_key_here

# SMTP Configuration (For sending emails)
# If using Gmail, use smtp.gmail.com and port 587
# You may need an App Password: https://myaccount.google.com/apppasswords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here

# Supabase Storage
# Create this bucket in Supabase Storage before starting the backend.
# Keep the service-role key backend-only; never expose it to the browser.

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must be registered as an authorized redirect URI in Google Cloud Console.
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/auth/google-calendar/callback
FRONTEND_URL=http://localhost:5173

# Role Detection (email domain matching)
TEACHER_EMAIL_DOMAIN=university.in
ADMIN_EMAILS=admin@eduai.suite

# Supabase Auth and Storage (project configured by .vscode/mcp.json)
# The service-role key must remain backend-only and is not needed by JWT verification.
AUTH_PROVIDER=supabase
SUPABASE_URL=https://ahqabwehrbnieawsxxpd.supabase.co
SUPABASE_AUTH_ISSUER=https://ahqabwehrbnieawsxxpd.supabase.co/auth/v1
SUPABASE_AUTH_AUDIENCE=authenticated
SUPABASE_AUTH_JWKS_URL=https://ahqabwehrbnieawsxxpd.supabase.co/auth/v1/.well-known/jwks.json
STORAGE_PROVIDER=supabase
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
SUPABASE_STORAGE_BUCKET=edui-presentations
SUPABASE_MAX_FILE_SIZE_BYTES=47185920
