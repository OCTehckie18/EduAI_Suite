GROQ_API_KEY=your_groq_api_key_here

# SMTP Configuration (For sending emails)
# If using Gmail, use smtp.gmail.com and port 587
# You may need an App Password: https://myaccount.google.com/apppasswords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here

# S3/MinIO Storage Configuration
# For local development: USE_S3=false, configure MinIO
# For production: USE_S3=true, configure AWS S3

# Development (MinIO)
USE_S3=false
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET_NAME=edui-presentations
S3_REGION=us-east-1

# Production (AWS S3)
# USE_S3=true
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# S3_BUCKET_NAME=your-bucket-name
# S3_REGION=us-east-1

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Role Detection (email domain matching)
TEACHER_EMAIL_DOMAIN=university.in
ADMIN_EMAILS=admin@eduai.suite

# Supabase Auth (set AUTH_PROVIDER=supabase only after configuring the project)
# The service-role key must remain backend-only and is not needed by JWT verification.
AUTH_PROVIDER=legacy
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_AUTH_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_AUTH_AUDIENCE=authenticated
SUPABASE_AUTH_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
STORAGE_PROVIDER=local
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
SUPABASE_STORAGE_BUCKET=edui-presentations
SUPABASE_MAX_FILE_SIZE_BYTES=47185920
